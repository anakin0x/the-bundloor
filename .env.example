# ─────────────────────────────────────────────────────────────────────────────
# THE BUNDLOOR — Environment Configuration
# Copy this file to .env and fill in your values. Never commit .env!
# ─────────────────────────────────────────────────────────────────────────────

# Solana RPC endpoint
# Free option:  https://api.mainnet-beta.solana.com  (limited, may be slow)
# Paid options: Helius (helius.dev), QuickNode, Triton — recommended for production
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com

# Funder wallet private key (base58 encoded)
# This is the wallet that funds all sub-wallets. Keep it safe. Never commit.
# To export from Phantom: Settings > Show Secret Recovery Phrase (use a dedicated trading wallet!)
PRIVATE_KEY=your_bs58_private_key_here

# Jito block engine for bundle submission (atomic multi-wallet buys)
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.labs.dev
# Tip paid to Jito validators per bundle (in lamports, 1 SOL = 1_000_000_000)
# 50000 = 0.00005 SOL — increase for higher priority during congestion
JITO_TIP_LAMPORTS=50000

# Trading defaults
SLIPPAGE_PCT=25
PRIORITY_FEE_MICROLAMPORTS=50000
# Maximum number of sub-wallets per bundle
MAX_WALLETS=30
# Extra SOL buffer per sub-wallet to cover transaction fees (~0.003 SOL is safe)
SOL_FEE_BUFFER_PER_WALLET=0.003

# Server port
PORT=3000

# ─────────────────────────────────────────────────────────────────────────────
# SECURITY WARNING:
# data/bundle.json will be created automatically and contains sub-wallet
# private keys needed for selling. This file is gitignored but you should
# keep it safe. Delete it after all positions are closed.
# ─────────────────────────────────────────────────────────────────────────────
